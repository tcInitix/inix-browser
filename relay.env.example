# Inix Region Relay — client configuration
# Copy values to your shell profile or a local relay.env (do not commit secrets).
#
# 1. Provision VPS: scripts/setup-inix-relay.sh (Dallas/Houston recommended)
# 2. Set these before launching Inix, or use Settings → Privacy → Custom proxy URL

INIX_RELAY_HOST=203.0.113.10
INIX_RELAY_PORT=1080
INIX_RELAY_USER=inix
INIX_RELAY_PASS=replace-with-generated-token

# Optional: connect relay automatically when Inix starts (also toggled in Settings)
# INIX_RELAY_CONNECT_ON_STARTUP=true

# --- Operations ---
# Token rotation: on VPS run `passwd inix`, then update INIX_RELAY_PASS here and restart Inix.
# Bandwidth cap (optional): ufw limit 1080/tcp on VPS, or use provider traffic alerts.
# Abuse: this relay is for personal browser traffic only; do not share credentials publicly.
